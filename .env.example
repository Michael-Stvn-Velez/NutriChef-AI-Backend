PORT=3000
MONGODB_URI=mongodb+srv://usuario:password@nutrichef-cluster.xxxxx.mongodb.net/nutrichef?retryWrites=true&w=majority
NODE_ENV=development

JWT_SECRET=your-secret-key
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d

# Gmail - contraseña de aplicación (https://myaccount.google.com/apppasswords)
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM=tu-correo@gmail.com
PASSWORD_RESET_CODE_EXPIRES_MINUTES=15
